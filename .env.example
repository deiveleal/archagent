# Copie para .env e preencha os valores. Nunca commite o .env.

# Alibaba Cloud Model Studio (DashScope)
DASHSCOPE_API_KEY=
# Token Plan (Singapura):    https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Internacional (Singapura): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# China (Pequim):            https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Modelos
LLM_MODEL_TEXT=qwen3.8-max
LLM_MODEL_VISION=qwen3.8-max

# Limites das chamadas
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS_PER_SESSION=200000
